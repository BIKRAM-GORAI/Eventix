# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/eventix?retryWrites=true&w=majority

# Cloudinary Storage Configuration (for Event Banners & Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service Configuration (Nodemailer SMTP / Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# System Admin Credentials (For initial seed / authorization checks)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASS=admin123
